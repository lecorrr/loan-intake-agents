# Copy to .env and fill in. An empty value means "not set".
# Every key is a setting of the app; an unknown key stops it at startup, so a typo can't hide.

# --- Model: a local Ollama by default ---------------------------------------------------------
# The instruct build. Plain qwen3-vl:8b is the reasoning build: it reasons before every answer,
# even when asked not to, which made each call about four times slower in testing.
LLM_MODEL=ollama:qwen3-vl:8b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Seconds per model call. The first call after a start also loads the model into VRAM.
LLM_TIMEOUT_S=180

# --- Telegram ---------------------------------------------------------------------------------
# Token from @BotFather. Empty: no bot, the HTTP API still works.
TELEGRAM_BOT_TOKEN=
# Where approval cards go: your own chat id for a solo demo, or a managers' group (negative id).
MANAGER_CHAT_ID=

# --- Manager HTTP API -------------------------------------------------------------------------
# Needed for POST /api/cases/{id}/decision and for reading Telegram cases over HTTP.
MANAGER_API_TOKEN=

# --- EspoCRM ----------------------------------------------------------------------------------
# The address EspoCRM opens at; the one docker compose runs is http://127.0.0.1:8090.
# Empty: deals stay in memory.
ESPOCRM_URL=
# Printed by `loan-agents crm-setup`, which creates the API user the app signs in as.
ESPOCRM_API_KEY=
# docker compose creates this administrator when EspoCRM starts for the first time; crm-setup
# signs in with it. Changing the password here later does not change it in EspoCRM.
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=
# Deal (Opportunity) stages for each step of a case; these are EspoCRM's own stage names.
ESPOCRM_STAGE_NEW=Prospecting
ESPOCRM_STAGE_REVIEW=Qualification
ESPOCRM_STAGE_APPROVED=Negotiation
ESPOCRM_STAGE_REJECTED=Closed Lost

# --- Langfuse tracing -------------------------------------------------------------------------
# Without keys nothing is traced. `loan-agents tracing-keys --write-env` fills in the keys and
# the password; `docker compose --profile tracing up -d` then runs Langfuse with them on
# 127.0.0.1:3000. For Langfuse Cloud, use its address and the keys from its project settings.
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse creates this user when it starts and has no user with this email; changing the
# password here later does not change it in Langfuse.
LANGFUSE_ADMIN_EMAIL=admin@loan-intake.local
LANGFUSE_ADMIN_PASSWORD=

# --- Storage ----------------------------------------------------------------------------------
# Postgres keeps cases and the audit trail across restarts. Empty: memory only.
# docker compose publishes one on 127.0.0.1:5433 and the app container uses it by default.
# Running natively against that container, use:
#   DATABASE_URL=postgresql://loan:loan@127.0.0.1:5433/loan
DATABASE_URL=

LOG_LEVEL=INFO
