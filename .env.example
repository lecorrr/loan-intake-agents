# Copy to .env and fill in. Empty means "not set"; unknown keys stop the app at startup.

# Model, a local Ollama by default. Use the instruct build: plain qwen3-vl:8b reasons before
# every answer and was about 4x slower in testing.
LLM_MODEL=ollama:qwen3-vl:8b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
# seconds per call; the first call also loads the model
LLM_TIMEOUT_S=180

# Telegram. Without a token there is no bot, but the HTTP API still works.
TELEGRAM_BOT_TOKEN=
# your own chat id for a solo demo, or a managers' group (negative id)
MANAGER_CHAT_ID=

# Manager HTTP API: decisions and reading Telegram cases
MANAGER_API_TOKEN=

# EspoCRM (compose runs it on http://127.0.0.1:8090). Empty URL: deals stay in memory.
ESPOCRM_URL=
# printed by `loan-agents crm-setup`
ESPOCRM_API_KEY=
# compose creates this admin on first start; changing the password here later won't change it
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=
# EspoCRM's own stage names for each step of a case
ESPOCRM_STAGE_NEW=Prospecting
ESPOCRM_STAGE_REVIEW=Qualification
ESPOCRM_STAGE_APPROVED=Negotiation
ESPOCRM_STAGE_REJECTED=Closed Lost

# Langfuse tracing, off without keys. `loan-agents tracing-keys --write-env` fills them in and
# `docker compose --profile tracing up -d` runs Langfuse on 127.0.0.1:3000.
# For Langfuse Cloud use its URL and your project's keys.
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# created on Langfuse's first start; changing the password here later won't change it
LANGFUSE_ADMIN_EMAIL=admin@loan-intake.local
LANGFUSE_ADMIN_PASSWORD=

# Postgres for cases and the audit trail; empty keeps them in memory. From the host, the
# compose database is postgresql://loan:loan@127.0.0.1:5433/loan
DATABASE_URL=

LOG_LEVEL=INFO
