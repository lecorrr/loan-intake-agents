# Copy to .env and fill in. An empty value means "not set".
# Every key is a setting of the app; an unknown key stops it at startup, so a typo can't hide.

# --- Model: a local Ollama by default ---------------------------------------------------------
# The instruct build. Plain qwen3-vl:8b is the reasoning build: it reasons before every answer,
# even when asked not to, which made each call about four times slower in testing.
LLM_MODEL=ollama:qwen3-vl:8b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Seconds per model call. The first call after a start also loads the model into VRAM.
LLM_TIMEOUT_S=180

# --- Telegram ---------------------------------------------------------------------------------
# Token from @BotFather. Empty: no bot, the HTTP API still works.
TELEGRAM_BOT_TOKEN=
# Where approval cards go: your own chat id for a solo demo, or a managers' group (negative id).
MANAGER_CHAT_ID=

# --- Manager HTTP API -------------------------------------------------------------------------
# Needed for POST /api/cases/{id}/decision and for reading Telegram cases over HTTP.
MANAGER_API_TOKEN=

# --- Bitrix24 ---------------------------------------------------------------------------------
# Inbound webhook with the crm scope: https://<portal>/rest/<user id>/<code>/
# Empty: deals stay in memory. docker compose points the app at the bundled mock instead.
# Running natively with the mock (`loan-agents mock-crm`), use:
#   B24_WEBHOOK_URL=http://127.0.0.1:8090/rest/1/demo-secret/
B24_WEBHOOK_URL=
# Deal stage ids of your pipeline; these are a new portal's defaults.
B24_STAGE_NEW=NEW
B24_STAGE_REVIEW=PREPARATION
B24_STAGE_APPROVED=EXECUTING
B24_STAGE_REJECTED=LOSE
# The mock's webhook code. If you change it, change it in B24_WEBHOOK_URL too.
MOCK_B24_SECRET=demo-secret

# --- Storage ----------------------------------------------------------------------------------
# Postgres keeps cases and the audit trail across restarts. Empty: memory only.
# docker compose publishes one on 127.0.0.1:5433 and the app container uses it by default.
# Running natively against that container, use:
#   DATABASE_URL=postgresql://loan:loan@127.0.0.1:5433/loan
DATABASE_URL=

LOG_LEVEL=INFO
